#pragma kernel GenerateWeatherMap2D

#define UI0 1597334673U
#define UI1 3812015801U
#define UI3 uint3(UI0, UI1, 2798796415U)
#define UIF (1.0 / float(0xffffffffU))

RWTexture2D<float4> Result2D;

float _CoverageScale;
float _CoverageOffset;
float _TypeScale;
float _PrecipitationScale;

int _Seed;
float3 _Resolution;
int _Octaves;
float _Lacunarity;
float _Gain;

float3 mod(float3 x, float y)
{
    return x - y * floor(x / y);
}

float remap(float v, float minOld, float maxOld, float minNew, float maxNew)
{
    return minNew + (v - minOld) * (maxNew - minNew) / (maxOld - minOld);
}

float3 hash33(float3 p, int seed)
{
    uint3 q = uint3(int3(p)) * UI3;
    q = (q.x ^ q.y ^ q.z) * UI3 * seed;
    return -1.0 + 2.0 * float3(q) * UIF;
}

float worleyNoise(float3 uv, float freq)
{
    float3 id = floor(uv);
    float3 p = frac(uv);
    
    float minDist = 10000.0;
    for (float x = -1.0; x <= 1.0; x++)
    {
        for (float y = -1.0; y <= 1.0; y++)
        {
            for (float z = -1.0; z <= 1.0; z++)
            {
                float3 offset = float3(x,y,z);
                float3 h = hash33(mod(id + offset, freq), _Seed) * 0.5 + 0.5;
                h += offset;
                float3 d = p - h;

                minDist = min(minDist, dot(d, d));
            }
        }
    }
    
    minDist = saturate(minDist);
    return 1.0 - minDist;
}

// Gradient noise by iq (modified to be tileable)
float gradientNoise(float3 x, float freq)
{
    // grid
    float3 p = floor(x);
    float3 w = frac(x);
    
    // quintic interpolant
    float3 u = w * w * w * (w * (w * 6. - 15.) + 10.);
    
    // gradients
    float3 ga = hash33(mod(p + float3(0., 0., 0.), freq), _Seed);
    float3 gb = hash33(mod(p + float3(1., 0., 0.), freq), _Seed);
    float3 gc = hash33(mod(p + float3(0., 1., 0.), freq), _Seed);
    float3 gd = hash33(mod(p + float3(1., 1., 0.), freq), _Seed);
    float3 ge = hash33(mod(p + float3(0., 0., 1.), freq), _Seed);
    float3 gf = hash33(mod(p + float3(1., 0., 1.), freq), _Seed);
    float3 gg = hash33(mod(p + float3(0., 1., 1.), freq), _Seed);
    float3 gh = hash33(mod(p + float3(1., 1., 1.), freq), _Seed);
    
    // projections
    float va = dot(ga, w - float3(0., 0., 0.));
    float vb = dot(gb, w - float3(1., 0., 0.));
    float vc = dot(gc, w - float3(0., 1., 0.));
    float vd = dot(gd, w - float3(1., 1., 0.));
    float ve = dot(ge, w - float3(0., 0., 1.));
    float vf = dot(gf, w - float3(1., 0., 1.));
    float vg = dot(gg, w - float3(0., 1., 1.));
    float vh = dot(gh, w - float3(1., 1., 1.));
	
    // interpolation
    return va + 
           u.x * (vb - va) + 
           u.y * (vc - va) + 
           u.z * (ve - va) + 
           u.x * u.y * (va - vb - vc + vd) + 
           u.y * u.z * (va - vc - ve + vg) + 
           u.z * u.x * (va - vb - ve + vf) + 
           u.x * u.y * u.z * (-va + vb + vc - vd + ve - vf - vg + vh);
}

float perlinFBM(float3 p, float freq)
{
    float G = exp2(-.85);
    float amp = 1.;
    float noise = 0.;
    for (int i = 0; i < _Octaves; ++i)
    {
        noise += amp * gradientNoise(p * freq, freq);
        freq *= 2.;
        amp *= G;
    }
    
    return noise;
}

float worleyFBM(float3 uvw, float freq)
{
    float result = 0.0;
    float amplitude = 1.0;
    float frequency = freq;
    float maxValue = 0.0;
    
    for (int i = 0; i < _Octaves; i++)
    {
        result += worleyNoise(uvw * frequency, frequency) * amplitude;
        maxValue += amplitude;
        amplitude *= _Gain;
        frequency = round(frequency * _Lacunarity);
    }
    
    return result / maxValue;
}

[numthreads(8,8,1)]
void GenerateWeatherMap2D (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Resolution.x || id.y >= (uint)_Resolution.y) return;

    float2 uv = (id.xy + 0.5) / _Resolution.xy;
    
    // ========================
    // Coverage
    // ========================
    float3 uvw_coverage = float3(uv * _CoverageScale, 0.5);
    float coverage = perlinFBM(uvw_coverage, 3.0) * 0.5 + 0.5;
    
    float coverageWorley = worleyFBM(uvw_coverage, 2.0);
    coverage = lerp(coverage, coverageWorley, 0.2);
    coverage = pow(coverage, 2.0);
    coverage = saturate(coverage + _CoverageOffset);
    
    // ========================
    // Cloud Type
    // ========================
    float3 uvw_type = float3(uv * _TypeScale, 0.3);
    float cloudType = perlinFBM(uvw_type, 3.0) * 0.5 + 0.5;
    
    float worleyType = worleyFBM(uvw_type, 4.0);
    cloudType = lerp(cloudType, worleyType, 0.4);
    cloudType = pow(saturate(cloudType), 0.8);
    
    // ========================
    // Precipitation
    // ========================
    float3 uvw_precip = float3(uv * _PrecipitationScale, 0.7);
    float precipitation = worleyFBM(uvw_precip, 3.0);
    float precipDetail = worleyFBM(uvw_precip * 2.0, 6.0);
    
    precipitation = lerp(precipitation, precipDetail, 0.3);
    precipitation = pow(saturate(precipitation), 3.0);
    
    // ========================
    // Erosion
    // ========================
    float3 uvw_detail = float3(uv * 8.0, 0.2);
    float detailScale = worleyFBM(uvw_detail, 8.0);
    
    float detailPerlin = perlinFBM(uvw_detail, 8.0) * 0.5 + 0.5;
    detailScale = lerp(detailScale, detailPerlin, 0.5);
    detailScale = saturate(detailScale);
    
    Result2D[id.xy] = float4(coverage, cloudType, precipitation, detailScale);
    // Result2D[id.xy] = coverage;
}